Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic: /sim/camera/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Isaac Left Camera
      Normalize Range: true
      Transport Hint: raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Image Topic: /sim/camera/depth
      Max Value: 15
      Median window: 5
      Min Value: 0.3
      Name: Isaac Registered Depth
      Normalize Range: true
      Transport Hint: raw
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic: /cones/all
      Name: Cone Markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic: /path/nominal_markers
      Name: Nominal Path Markers
      Value: true
    - Alpha: 0.55
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: Inflated Obstacles
      Topic: /obstacles/local_grid
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Decay Time: 0.2
      Enabled: false
      Name: Depth Obstacle Points
      Point Size: 2
      Style: Pixels
      Topic: /obstacles/points
      Value: false
    - Class: rviz_default_plugins/Path
      Color: 255; 180; 30
      Enabled: true
      Line Style: Lines
      Line Width: 0.04
      Name: Nominal Path
      Pose Style: None
      Topic: /path/nominal
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 25; 255; 25
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: Path
      Pose Style: None
      Topic: /path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 3
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.65
      Target Frame: base_link
      Yaw: 3.14
Window Geometry:
  Height: 900
  Width: 1400
